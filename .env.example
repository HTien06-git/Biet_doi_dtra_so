# ============================================================================
# BIỆT ĐỘI ĐIỀU TRA SỐ - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sử dụng cho Vercel Deployment & Local Development
# ============================================================================

# 1. CẤU HÌNH SUPABASE (TÙY CHỌN - TỰ ĐỘNG FALLBACK LOCALSTORAGE NẾU TRỐNG)
# Lấy từ Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Biến môi trường cho Backend API Serverless
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. MẬT KHẨU TRANG QUẢN TRỊ ADMIN (/admin)
# Dùng để xác thực quyền quản trị viên, xem bảng thành tích, xuất CSV
ADMIN_PASSWORD=Admin@2026
NEXT_PUBLIC_ADMIN_PASSWORD=Admin@2026

# 3. ĐỊA CHỈ TRANG WEB KHI DEPLOY VERCEL
NEXT_PUBLIC_APP_URL=https://biet-doi-dtra-so.vercel.app
NODE_ENV=production
